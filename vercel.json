{
  "cleanUrls": true,
  "headers": [
    {"source": "/(.*)\.(webp|jpg|jpeg|png|avif|svg|woff2)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"}]},
    {"source": "/admin.html", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]}
  ]
}