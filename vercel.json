{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/auto.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/miasta/rybnik.html",
      "destination": "/api/miasto-rybnik"
    },
    {
      "source": "/sitemap-artykuly.xml",
      "destination": "/api/sitemap-artykuly"
    },
    {
      "source": "/sitemap-ogloszenia.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/samochody/:brand/:city",
      "destination": "/api/seo-kategoria?brand=:brand&city=:city"
    },
    {
      "source": "/samochody/:brand",
      "destination": "/api/seo-kategoria?brand=:brand"
    },
    {
      "source": "/auto/:slug",
      "destination": "/api/seo-auto?slug=:slug"
    },
    {
      "source": "/polityka-prywatnosci",
      "destination": "/polityka-prywatnosci.html"
    },
    {
      "source": "/regulamin",
      "destination": "/regulamin.html"
    },
    {
      "source": "/polityka-cookies",
      "destination": "/polityka-cookies.html"
    },
    {
      "source": "/rodo",
      "destination": "/rodo.html"
    }
  ],
  "functions": {
    "api/seo-auto.js": {
      "includeFiles": "auto.html"
    },
    "api/sitemap-artykuly.js": {
      "includeFiles": "blog/**"
    },
    "api/miasto-rybnik.js": {
      "includeFiles": "miasta/rybnik.html"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<listingId>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})"
        }
      ],
      "destination": "/auto/:listingId",
      "statusCode": 301
    }
  ]
}
